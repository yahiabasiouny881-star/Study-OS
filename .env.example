# Copy this file to ".env" and fill in the values you need. NEVER commit ".env".
# Placeholder names only - there are no real keys in this file.

# ---- Provider keys (set one or both; leave blank to disable that provider) ----
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Models offered in the app's model selector (comma separated) ----
# First item is the default. Check the official model pages before changing these.
OPENAI_MODELS=gpt-6-luna,gpt-6.1-sol
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Optional: OpenAI reasoning effort sent with requests (none|low|medium|high). Leave blank to omit.
OPENAI_REASONING_EFFORT=

# ---- Network ----
PORT=3000
# 127.0.0.1 = only this computer can reach the server (recommended for local use).
HOST=127.0.0.1
# Extra browser origins allowed to call the API (comma separated). The server's own
# http://localhost:PORT and http://127.0.0.1:PORT origins are always allowed.
ALLOWED_ORIGINS=

# ---- Access control (REQUIRED if HOST is not 127.0.0.1 / localhost) ----
# A long random string. Clients must send it as "Authorization: Bearer <token>".
# Generate one on Windows PowerShell:  [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
ACCESS_TOKEN=

# ---- Spending / abuse limits ----
RATE_LIMIT_PER_MINUTE=20
DAILY_REQUEST_LIMIT=200
MAX_INPUT_CHARS=24000
MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT_MS=30000
